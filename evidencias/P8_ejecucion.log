  "output": "+ set -euo pipefail\n+ export MSYS_NO_PATHCONV=1\n+ MSYS_NO_PATHCONV=1\n+ case \"${1:-}\" in\n+ docker exec sr_bd psql -U postgres -d core -c 'SELECT count(*) AS cuentas_activas_cesados, count(DISTINCT e.documento) AS personas, min(e.fecha_cese) AS cese_mas_antiguo FROM usuarios u JOIN empleados e ON e.documento=u.documento WHERE u.estado='\\''activo'\\'' AND e.fecha_cese IS NOT NULL' -c 'SELECT count(*) AS sin_documento, count(*) FILTER (WHERE perfil='\\''ADMIN'\\'') AS administradores FROM usuarios WHERE documento IS NULL AND estado='\\''activo'\\''' -c 'SELECT DATE '\\''2025-12-31'\\'' - DATE '\\''2025-11-14'\\'' AS dias_sin_respaldo' -c 'SELECT count(*) AS desembolsos_core, sum(monto) AS monto_total_core FROM desembolsos' -c '\\dt'\n+ tee evidencias/P8_validacion.txt\n cuentas_activas_cesados | personas | cese_mas_antiguo \n-------------------------+----------+------------------\n                      16 |       10 | 2015-12-18\n(1 row)\n\n sin_documento | administradores \n---------------+-----------------\n            22 |               4\n(1 row)\n\n dias_sin_respaldo \n-------------------\n                47\n(1 row)\n\n desembolsos_core | monto_total_core \n------------------+------------------\n             4812 |      45124350.88\n(1 row)\n\n            List of relations\n Schema |    Name     | Type  |  Owner   \n--------+-------------+-------+----------\n public | desembolsos | table | postgres\n public | empleados   | table | postgres\n public | usuarios    | table | postgres\n(3 rows)\n\n+ nl -ba respaldos/respaldo.sh\n     1\t#!/bin/sh\n     2\t# Tarea programada del respaldo del core · cron: 0 2 * * *\n     3\t# 01/11/2025 · Jefe de Sistemas · \"el respaldo tarda mucho; se excluye la tabla más pesada\"\n     4\tpg_dump -U postgres -d core --exclude-table=desembolsos > /respaldos/core_$(date +%F).sql\n+ nl -ba bd/01_core.sql\n     1\t-- Base de datos del core financiero · COOPAC Santa Rosa\n     2\t-- Carga inicial desde la extracción entregada por la cooperativa\n     3\t\n     4\tCREATE TABLE empleados (\n     5\t    documento      varchar(8) PRIMARY KEY,\n     6\t    nombre         text,\n     7\t    area           text,\n     8\t    fecha_ingreso  date,\n     9\t    fecha_cese     date\n    10\t);\n    11\t\n    12\tCREATE TABLE usuarios (\n    13\t    usuario        text PRIMARY KEY,\n    14\t    documento      varchar(8),\n    15\t    perfil         text,\n    16\t    estado         text,\n    17\t    ultimo_acceso  date\n    18\t);\n    19\t\n    20\tCREATE TABLE desembolsos (\n    21\t    id                 text PRIMARY KEY,\n    22\t    fecha              date,\n    23\t    monto              numeric(12,2),\n    24\t    usuario_registra   text,\n    25\t    usuario_aprueba    text,\n    26\t    umbral_aprobacion  numeric(12,2)\n    27\t);\n    28\t\n    29\tCOPY empleados   FROM '/datos/empleados.csv'     WITH (FORMAT csv, HEADER true);\n    30\tCOPY usuarios    FROM '/datos/usuarios_core.csv' WITH (FORMAT csv, HEADER true);\n    31\tCOPY desembolsos FROM '/datos/desembolsos.csv'   WITH (FORMAT csv, HEADER true);\n    32\t\n    33\t-- Cuentas de base de datos creadas por el área de TI\n    34\tCREATE ROLE app_core   LOGIN SUPERUSER PASSWORD 'app_core';\n    35\tCREATE ROLE reportes   LOGIN PASSWORD 'reportes2022';\n    36\tCREATE ROLE ex_soporte LOGIN PASSWORD 'soporte2021';\n    37\tGRANT SELECT ON ALL TABLES IN SCHEMA public TO reportes, ex_soporte;\n",
